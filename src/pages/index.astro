---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
---

<Layout
  ><div id="main">
    <Hero
      tagline="Your places. On your cards. On your server."
      title="Good places. Worth keeping."
      subtitle="A self-hosted library for the places you care about. Bring your saved places together, keep the details that matter, and rediscover somewhere worth going."
      actions={[
        { text: 'Install Placard', href: '/docs/install', variant: 'primary' },
        { text: 'View on GitHub', href: 'https://github.com/placard-app/core' },
      ]}
      image={{ src: '/library-hero.webp', alt: 'Placard library showing saved places as cards' }}
    />
    <Features
      title="A home for your saved places"
      items={[
        {
          title: 'Bring your library together',
          description: 'Import Google Takeout saves and organize places with lists, tags, notes and photos.',
          icon: 'tabler:map-pin',
        },
        {
          title: 'Remember and rediscover',
          description: 'Search your own collection and find places near you when you need them.',
          icon: 'tabler:search',
        },
        {
          title: 'Keep ownership',
          description: 'Run Placard with Docker Compose. Your database and media live on your server.',
          icon: 'tabler:home',
        },
      ]}
    />
    <section class="panel">
      <h2>A few extra possibilities.</h2><p>
        Plan a Day Out, keep Menus with restaurants, record visits, or let Pick choose tonight. Add optional modules
        when you need them.
      </p><a class="btn" href="/plugins">Explore modules</a>
    </section>
    <section class="panel">
      <h2>Make room on your server.</h2><p>
        Install Docker, run the installer, and create your administrator account. The installation guide covers
        configuration, HTTPS, upgrades and backups.
      </p><a class="btn-primary" href="/docs/install">Install Placard</a>
    </section>
    <FAQs
      title="Before you make room"
      items={[
        {
          title: 'Where does my data live?',
          description: 'On your own instance, in your database and media storage. You manage access and backups.',
        },
        {
          title: 'Do I need a Google API key?',
          description:
            'Google enrichment uses your own Google Maps Platform key. See the Google APIs guide for setup and billing details.',
        },
        {
          title: 'Can I use Placard with my household?',
          description: 'Multi-user accounts are supported. An administrator controls household place sharing.',
        },
        {
          title: 'Is Placard open source?',
          description:
            'Yes. Placard is licensed under AGPL-3.0. You can inspect the source, self-host and contribute on GitHub.',
        },
      ]}
    />
  </div></Layout
>
