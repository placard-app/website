---
import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { plugins } from '~/docs/plugins';
import '~/assets/styles/marketing.css';

const featured = ['places.day-out', 'places.menus', 'places.pick'].flatMap((id) =>
  plugins.filter((plugin) => plugin.id === id)
);
---

<Layout metadata={{ title: 'Placard — Good places. Worth keeping.', ignoreTitleTemplate: true }}>
  <div id="main" class="marketing">
    <section class="hero-section wrap">
      <div class="hero-copy">
        <p class="eyebrow">A place for your places</p>
        <h1>Good places.<br /><em>Worth keeping.</em></h1>
        <p class="hero-description">
          A self-hosted library for the places you care about. Bring your saved places together and keep the details
          that make them yours.
        </p>
        <div class="actions">
          <a class="action action-primary" href="/docs/install">Install Placard </a>
          <a class="text-link" href="https://github.com/placard-app/core">View on GitHub </a>
        </div>
        <p class="hero-note">OPEN SOURCE <span> / </span> SELF-HOSTED <span> / </span> YOUR DATA</p>
      </div>
      <div class="hero-visual">
        <div class="stage-label"><span>YOUR LIBRARY</span><span>PLACARD</span></div>
        <div class="screenshot-frame">
          <img
            src="/library-hero.webp"
            alt="Placard library showing saved places as cards"
            width="1440"
            height="756"
            fetchpriority="high"
          />
        </div>
        <p class="stage-caption"><span>THE PLACES YOU WANT TO REMEMBER.</span><span>ALL IN ONE PLACE</span></p>
      </div>
    </section>

    <section class="intro-section wrap">
      <div><p class="eyebrow">YOUR LIBRARY</p><h2>Keep the places.<br />Keep the details.</h2></div>
      <div class="intro-copy">
        <p>
          Placard gives your saved places a home on your own server. Import your Google Takeout saves, add your own
          notes and photos, and find the right place when you need it.
        </p><a class="text-link" href="/docs/product-overview">Get to know Placard </a>
      </div>
      <div class="benefits">
        <div>
          <h3>Bring it together</h3><p>Organize your collection with lists, tags, notes and photos.</p>
        </div>
        <div><h3>Find it again</h3><p>Search your library or discover saved places near you.</p></div>
        <div><h3>Make it yours</h3><p>Run Placard on your server, with your database and media.</p></div>
      </div>
    </section>

    <section class="modules-section">
      <div class="wrap">
        <div class="section-heading">
          <div><p class="eyebrow">OPTIONAL MODULES</p><h2>More ways to use<br />your places.</h2></div><div>
            <p>Make plans, save menus, or let your library choose. Add the tools you need.</p><a
              class="text-link"
              href="/plugins"
              >Explore all modules
            </a>
          </div>
        </div>
        <div class="featured-grid">
          {
            featured.map((plugin) => (
              <a class="featured-card" href={'/plugins#' + plugin.id}>
                <>
                  <div class="featured-image">
                    <img
                      src={'/plugins/' + plugin.screenshot}
                      alt={plugin.name + ' in Placard'}
                      width={plugin.screenshotWidth}
                      height={plugin.screenshotHeight}
                      loading="lazy"
                    />
                  </div>
                  <div class="featured-info">
                    <>
                      <div>
                        <>
                          <span>MODULE</span>
                          <h3>{plugin.name}</h3>
                          <p>{plugin.tagline}</p>
                        </>
                      </div>
                    </>
                  </div>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="install-section wrap">
      <div class="install-panel">
        <div><p class="eyebrow">GET STARTED</p><h2>Make room on<br />your server.</h2></div><div>
          <p>
            Install Docker, run the installer, and create your administrator account. The guide covers configuration,
            HTTPS, upgrades and backups.
          </p><a class="action action-light" href="/docs/install">Install Placard </a>
        </div>
      </div>
    </section>
    <FAQs
      title="A few things to know"
      items={[
        {
          title: 'Where does my data live?',
          description: 'On your own instance, in your database and media storage. You manage access and backups.',
        },
        {
          title: 'Do I need a Google API key?',
          description:
            'Google enrichment uses your own Google Maps Platform key. See the Google APIs guide for setup and billing details.',
        },
        {
          title: 'Can I use Placard with my household?',
          description: 'Multi-user accounts are supported. An administrator controls household place sharing.',
        },
        {
          title: 'Is Placard open source?',
          description:
            'Yes. Placard is licensed under AGPL-3.0. You can inspect the source, self-host and contribute on GitHub.',
        },
      ]}
    />
  </div>
</Layout>
