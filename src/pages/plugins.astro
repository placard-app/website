---
import Layout from '~/layouts/PageLayout.astro';
import { plugins } from '~/docs/plugins';
---

<Layout metadata={{ title: 'Modules', description: 'Optional tools for your Placard place library.' }}
  ><div id="main" class="panel">
    <h1>Your library. A few extra possibilities.</h1><p>
      Optional modules for planning outings, remembering visits and choosing where to go together.
    </p><div class="module-grid">
      {
        plugins.map((p) => (
          <article>
            <>
              <img src={'/plugins/' + p.image} alt={p.alt} width="640" height="360" loading="lazy" />
              <h2>{p.name}</h2>
              <p>
                <strong>{p.tagline}</strong>
              </p>
              <p>{p.description}</p>
              <ul>
                {p.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <details>
                <>
                  <summary>See {p.name} in Placard</summary>
                  <img src={'/plugins/' + p.screenshot} alt={p.name + ' screenshot'} loading="lazy" />
                </>
              </details>
              <a href={'https://github.com/placard-app/module-' + p.id.slice(7)}>Guide and source on GitHub</a>
            </>
          </article>
        ))
      }
    </div><h2>Add a module</h2><p>
      Open Marketplace in your instance. Ask an administrator to activate a listed module or install it using its GitHub
      repository URL. Install code you trust and back up your data before updating.
    </p><a href="/docs/install">Install Placard first</a>
  </div></Layout
>
